# Copy to .env.local (local dev) or add in Vercel → Project → Settings → Environment Variables.
# Everything is optional: with nothing set, the shop runs on the sample catalog in data/seed.ts.

# Public site URL (used for social share images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Phase 1/4): inventory database + photo storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Phase 3): Apple Pay, Google Pay and cards
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Claude API (Phases 4 and 6): listing autofill + trend agent
ANTHROPIC_API_KEY=

# Resend (Phase 3/6): order emails + weekly trend report
RESEND_API_KEY=
OWNER_EMAIL=
