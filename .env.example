# Copy to .env.local (local dev) or add in Vercel → Project → Settings → Environment Variables.
# Everything is optional: with nothing set, the shop runs on the sample catalog in data/seed.ts.

# Public site URL (used for social share images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Phase 1/4): inventory database + photo storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# The one email address allowed into /admin
ADMIN_EMAIL=

# Stripe (Phase 3): Apple Pay, Google Pay and cards. Use sk_test_… until launch.
STRIPE_SECRET_KEY=
# From Dashboard → Developers → Webhooks → your endpoint → Signing secret (whsec_…)
STRIPE_WEBHOOK_SECRET=
# Set to 1 after turning on Stripe Tax in the Dashboard
STRIPE_AUTOMATIC_TAX=

# Claude API (Phases 4 and 6): listing autofill + trend agent
ANTHROPIC_API_KEY=

# Resend (Phase 3/6): order emails + weekly trend report
RESEND_API_KEY=
# Sender address on a domain you've verified in Resend
EMAIL_FROM=
# Where new-order notifications go
OWNER_EMAIL=

# TMDB (Phase 4): finds official trailers for VHS listings
TMDB_API_KEY=
